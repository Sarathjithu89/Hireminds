NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# Local Redis (Docker)
REDIS_URL=redis://localhost:6379

# MongoDB (Atlas M0 URI or local Docker mongodb-atlas-local)
MONGODB_URI=mongodb://root:rootpassword@localhost:27017/hireminds?authSource=admin&directConnection=true

# JWT Auth
JWT_ACCESS_SECRET=replace-with-32-plus-char-random-secret
JWT_REFRESH_SECRET=replace-with-different-32-plus-char-secret

# Google Gemini Free Tier (https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-keys